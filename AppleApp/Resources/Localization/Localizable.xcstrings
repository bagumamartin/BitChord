          "stringUnit": {
            "state": "translated",
            "value": "Anda ingin dipanggil apa?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vuoi che ti chiamiamo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どうお呼びしましょうか?"
          }
        },
