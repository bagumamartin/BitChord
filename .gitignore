# Gradle / Kotlin
.gradle/
.kotlin/
**/build/
local.properties

# Rust
native-core/target/
native-core/bindings/
native-core/build-xcframework/

# Xcode — all generated: project by xcodegen, frameworks by the build scripts,
# Info.plists + entitlements by xcodegen from project.yml
AppleApp/*.xcodeproj
AppleApp/Frameworks/
AppleApp/Generated/
AppleApp/BitChord-Info.plist
AppleApp/BitChordWidget-Info.plist
AppleApp/*.entitlements
xcuserdata/
DerivedData/

# Automix ONNX graphs — fetched by scripts/fetch-automix-models.sh into a
# development/CI cache, never into the app bundle.
native-core/fixtures/models/

# Synthetic Automix score fixtures (generated by scripts/generate_automix_fixtures.py)
native-core/fixtures/automix/*.wav
native-core/fixtures/automix/*.flac
native-core/fixtures/automix/*.aiff

# Working parity/audit notes — kept locally, deliberately never published.
# The release specs at the repo root (*.md) are the tracked documents.
docs/

.DS_Store

# Scratch homes for a sandboxed attempt at the shared-framework build. Gradle
# and Kotlin/Native both want to write outside the workspace by default, so a
# sandboxed run has to relocate them here; neither is part of the project.
.gradle-sandbox/
.konan-sandbox/

# Local device captures and investigation reports must stay private.
/native-core/audio-validation/
/AppleApp/tests/NativeResumeDeviceVerification/
/AppleApp/tests/NowPlayingDeviceFindings.md
/AppleApp/tests/NowPlayingMixingRepro/device-*
